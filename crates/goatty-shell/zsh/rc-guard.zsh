# goatty managed zsh: what your .zshrc sources while goatty's shell runs it
# (shell.zsh.user_rc). Generated by goatty: don't edit.
#
# Your .zshrc's `source FILE ARGS…` and `. FILE ARGS…` come here as
# `source rc-guard.zsh N CALLER-ARGS… FILE ARGS…`: N is how many arguments
# the caller had, so FILE without arguments of its own sees the caller's,
# as with plain `source`. Sourcing (not a function) keeps FILE at top level,
# so its `typeset`s stay global. Frameworks and prompts that would fight
# goatty's, and second copies of goatty's own plugins, are skipped and
# listed in goatty-status.

typeset -ga _goatty_rc_caller=("${@[2,$1+1]}")
builtin shift $(( $1 + 1 ))
[[ $1 == -- ]] && builtin shift
if (( $# == 0 )); then
  builtin source
  builtin return
fi
if _goatty_rc_blocked "$1"; then
  _goatty_rc_skipped+=("$REPLY")
  builtin return 0
fi
REPLY=$1
builtin shift
(( $# )) || builtin set -- "${_goatty_rc_caller[@]}"
builtin source "$REPLY" "$@"
