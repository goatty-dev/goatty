# goatty's shell in every terminal (Settings → Shell; docs/managed-zsh.md).
# Generated by goatty: don't edit. Sourced by the line goatty added to your
# .zshenv when you turned it on; `goattyd shell everywhere off` (or deleting
# that line) stops it. Plain zsh for one shell: GOATTY_SHELL_MANAGED=0 zsh
#
# Interactive shells started anywhere (an IDE's terminal, another terminal,
# tmux, an SSH login) switch to goatty's startup files here. Scripts and
# `zsh -c` stay plain, and so do shells goatty started itself (they're
# managed already) and goatty's look at your own setup (GOATTY_IMPORT).

[[ -o interactive ]] || builtin return 0
(( ${+_goatty_dir} || ${+GOATTY_IMPORT} )) && builtin return 0
[[ ${(L)GOATTY_SHELL_MANAGED-} == (0|false|no|off) ]] && builtin return 0
# 1 while shell.managed is on and the shell is zsh (the settings window can
# turn goatty's zsh off; this line then stays and does nothing).
(( @MANAGED@ )) || builtin return 0

# Keep it current. goatty's sessions rebuild the configuration and re-read
# what your startup files set up whenever one starts; nobody does that for
# these shells. So when a startup file, host.json or goattyd changed since
# the last check, ask goattyd to do it now (an installer that just added
# itself to .zshrc then works in the next terminal). It waits at most 2 s,
# then finishes in the background for the shells after this one.
() {
  builtin emulate -L zsh
  local stamp=@STAMP@ daemon=@DAEMON@ f
  # The goattyd that built this, else the one on PATH (it moved, or this
  # was built by `goatty --local`).
  [[ -n $daemon && -x $daemon ]] || daemon=${commands[goattyd]-}
  [[ -n $daemon ]] || return 0
  local zd=${ZDOTDIR:-$HOME}
  local -a files=(@HOST_FILE@ $daemon $zd/.zshenv $zd/.zprofile $zd/.zshrc $zd/.zlogin
    $HOME/.zshenv $HOME/.zprofile $HOME/.zshrc $HOME/.zlogin
    $HOME/.bashrc $HOME/.bash_profile $HOME/.bash_login $HOME/.profile
    /etc/zshenv /etc/zsh/zshenv /etc/zprofile /etc/zsh/zprofile /etc/zshrc /etc/zsh/zshrc
    /etc/profile /etc/profile.d /etc/bash.bashrc /etc/bashrc)
  if [[ -e $stamp ]]; then
    for f in $files; do
      [[ $f -nt $stamp ]] && break
    done
    [[ $f -nt $stamp ]] || return 0
  fi
  "$daemon" shell refresh --wait 2 </dev/null >/dev/null 2>&1
  return 0
}

# Hand over to goatty's .zshenv. It runs right here, inside your .zshenv
# (so it doesn't source that again), and points ZDOTDIR at goatty's
# directory: zsh reads goatty's .zprofile and .zshrc next, which run yours
# with your own ZDOTDIR as in goatty's sessions.
if (( ${+ZDOTDIR} )); then
  typeset -g GOATTY_ORIG_ZDOTDIR=$ZDOTDIR
else
  builtin unset GOATTY_ORIG_ZDOTDIR
fi
builtin export ZDOTDIR=@DIR@
typeset -g _goatty_hooked=1
builtin source -- "$ZDOTDIR/.zshenv"
builtin unset _goatty_hooked
