# goatty managed zsh: .zlogin. Generated by goatty: don't edit.
#
# Normally zsh never reads this file: .zshrc hands ZDOTDIR back to you, so
# zsh reads your own .zlogin. It only runs when something pointed ZDOTDIR
# at goatty's directory again in between (VS Code's shell integration does,
# with goatty's shell in every terminal, or a .zshrc that stopped early).
# Then it hands ZDOTDIR back and runs your .zlogin.

if (( ${+_goatty_zdotdir_final} )); then
  builtin export ZDOTDIR=$_goatty_zdotdir_final
elif (( ${+_goatty_user_zdotdir} )); then
  builtin export ZDOTDIR=$_goatty_user_zdotdir
else
  builtin unset ZDOTDIR
fi
if [[ -r ${ZDOTDIR:-$HOME}/.zlogin && ${${ZDOTDIR:-$HOME}:A} != ${_goatty_dir:A} ]]; then
  builtin source -- "${ZDOTDIR:-$HOME}/.zlogin"
fi
