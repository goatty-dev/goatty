# goatty managed zsh, startup file 3 of 3: .zshrc (interactive shells).
# Generated by goatty and rewritten whenever a session starts: don't edit.
# Your own additions go in ~/.config/goatty/zshrc (sourced near the end).
# Plain zsh with only your dotfiles instead: GOATTY_SHELL_MANAGED=0.
#
# Load order matters: options and completion first, then line-editor
# plugins, the prompt, shell integration, your additions, and syntax
# highlighting last (it has to wrap every widget defined before it).
# The tools themselves (fzf, fzf-tab, autosuggestions, Starship, syntax
# highlighting, and the plugins you install) are plugins: each loads in its
# slot from a generated plugins-*.zsh file.
#
# Every feature is optional: a missing tool is skipped and shows up in
# `goatty-status` and `goattyd shell status`.

# PATH after each startup step (started in .zshenv): the system's zshrc ran.
_goatty_path_marks+=("etc-zshrc"$'\t'"$PATH")

# feature -> "ok<TAB>detail" | "missing" | "off"
typeset -gA _goatty_state
# package -> the zsh script found for it (system copy or goatty's)
typeset -gA _goatty_src

_goatty_on() { (( ${_goatty_features[(Ie)$1]} )) }
_goatty_find() {
  local f
  for f in "$@"; do
    [[ -r $f ]] && { REPLY=$f; return 0 }
  done
  return 1
}
_goatty_ok() { _goatty_state[$1]="ok"$'\t'"$2" }

# --- What your own shell sets up (shell.import) -----------------------------
# goatty ran your login shell with its startup files in a separate process
# and noted the variables and PATH folders it added (import.zsh, written by
# goatty). They apply here, before the plugins look for their tools. A
# folder that's on PATH already keeps its place (.zshenv and .zprofile
# decided it); the new ones go in front, as your old terminal had them.
if (( _goatty_import )); then
  if [[ -r $_goatty_import_file ]] && builtin source -- "$_goatty_import_file"; then
    () {
      local k v
      for k v in "${_goatty_imported_vars[@]}"; do
        (( ${_goatty_import_skip_vars[(Ie)$k]} )) && continue
        [[ ${parameters[$k]-} == *readonly* ]] && continue
        builtin export "$k=$v"
      done
    }
    if (( $#_goatty_imported_path && ! ${_goatty_import_skip_vars[(Ie)PATH]} )); then
      typeset -gU path
      path=("${(@)_goatty_imported_path:|path}" $path)
    fi
    if [[ -n $_goatty_imported_from ]]; then
      _goatty_ok import "$_goatty_imported_from"
    else
      _goatty_state[import]=missing
    fi
  else
    _goatty_state[import]=missing
  fi
  _goatty_path_marks+=("imported"$'\t'"$PATH")
fi

# --- Options ----------------------------------------------------------------
setopt auto_cd auto_pushd pushd_ignore_dups pushd_silent
setopt interactive_comments no_beep
# Ctrl+S/Ctrl+Q are keys, not XOFF/XON (the PTY has ixon off too).
setopt no_flow_control
setopt complete_in_word always_to_end

# --- History (settings: history.*) -------------------------------------------
# Same file plain zsh would use, so existing history keeps working.
: ${HISTFILE:=${_goatty_user_zdotdir:-$HOME}/.zsh_history}
HISTSIZE=$_goatty_hist_size
SAVEHIST=$_goatty_hist_size
setopt $_goatty_hist_opts

# --- PATH -------------------------------------------------------------------
# Tools goatty installed (goatty-setup) come after the system's, so an
# installed package always wins.
typeset -gU path fpath
# Folders added in goatty's settings (shell.path), in order; `~/` is $HOME,
# folders that don't exist are skipped.
() {
  local dir
  for dir in "${_goatty_path[@]}"; do
    [[ $dir == '~' || $dir == '~/'* ]] && dir=$HOME${dir#\~}
    [[ -d $dir ]] && path+=("$dir")
  done
}
_goatty_path_marks+=("settings"$'\t'"$PATH")
path+=("$_goatty_bin")
_goatty_path_marks+=("tools"$'\t'"$PATH")
# Completion functions of goatty and goatty's tools (goattyd's, starship's
# when goatty installed it), after the system's for the same reason.
fpath+=("$_goatty_fpath")

# --- Plugins: completion paths and environment -------------------------------
# Before compinit, so plugin completions are found. `goattyd plugin list`
# shows what's installed.
builtin source -- "$_goatty_dir/plugins-early.zsh"
_goatty_path_marks+=("plugins"$'\t'"$PATH")

# --- Keys -------------------------------------------------------------------
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
() {
  local key
  local -A keys=(
    '^[[A'    up-line-or-beginning-search    # Up: history matching what's typed
    '^[OA'    up-line-or-beginning-search
    '^[[B'    down-line-or-beginning-search
    '^[OB'    down-line-or-beginning-search
    '^[[H'    beginning-of-line              # Home
    '^[OH'    beginning-of-line
    '^[[F'    end-of-line                    # End
    '^[OF'    end-of-line
    '^[[3~'   delete-char                    # Delete
    '^[[1;5C' forward-word                   # Ctrl+Right
    '^[[1;5D' backward-word                  # Ctrl+Left
    '^[[3;5~' kill-word                      # Ctrl+Delete
    '^H'      backward-kill-word             # Ctrl+Backspace
    '^[[Z'    reverse-menu-complete          # Shift+Tab
  )
  for key in ${(k)keys}; do
    bindkey -- $key ${keys[$key]}
  done
}
# Word motions stop at path separators.
WORDCHARS=${WORDCHARS//\/}

# --- Completion -------------------------------------------------------------
[[ -d $_goatty_cache ]] || mkdir -p -- "$_goatty_cache"
zmodload -i zsh/complist
autoload -Uz compinit
compinit -i -d "$_goatty_cache/zcompdump-$ZSH_VERSION"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$_goatty_cache/zcompcache"

# --- Expansions (shell.expansions) -------------------------------------------
# Plain words that turn into a command on Space (`| first 20 lines` →
# `| head -n 20`; expand.zsh). Bound here, before the line editor plugins,
# so autosuggestions and syntax highlighting wrap these widgets, and your
# own .zshrc or additions can still bind Space, Enter or Backspace.
if _goatty_on expansions && builtin source -- "$_goatty_dir/expand.zsh"; then
  _goatty_ok expansions "${#_goatty_exp_re} rules"
else
  _goatty_state[expansions]=off
fi

# --- The user's .zshrc (opt-in: GOATTY_ZSH_USER_RC=1) ----------------------
# Guarded: what it sources goes through rc-guard.zsh, which skips prompt and
# plugin frameworks (oh-my-zsh, Powerlevel10k, zinit, …) and second copies
# of goatty's own plugins; `compinit` (goatty ran it) and `starship init`,
# `oh-my-posh init` and `fzf --zsh` do nothing. Everything else runs.
typeset -g _goatty_ps1_before=$PS1
if (( _goatty_user_rc )); then
  _goatty_zdotdir_user
  if _goatty_user_file .zshrc; then
    typeset -ga _goatty_rc_skipped=()
    # What the user's file (and what it sources) may not load: a label, or
    # status 1. $1: the file.
    _goatty_rc_blocked() {
      local off=${(j: :)${(k)_goatty_state[(R)off]}}
      case $1 in
        */oh-my-zsh.sh) REPLY=oh-my-zsh ;;
        */p10k-instant-prompt-*.zsh|*/powerlevel10k.zsh-theme|*/powerlevel9k.zsh-theme|*/.p10k.zsh|*/p10k.zsh) REPLY=powerlevel10k ;;
        */.zprezto/init.zsh|*/zprezto/init.zsh) REPLY=prezto ;;
        */.zim/init.zsh|*/zim/init.zsh|*/zimfw.zsh) REPLY=zim ;;
        */antigen.zsh) REPLY=antigen ;;
        */antidote.zsh|*/.zsh_plugins.zsh) REPLY=antidote ;;
        */zinit.zsh|*/zi.zsh) REPLY=zinit ;;
        */zplug/init.zsh) REPLY=zplug ;;
        */zsh-autosuggestions.zsh|*/zsh-autosuggestions.plugin.zsh) [[ " $off " == *" autosuggestions "* ]] && return 1; REPLY=zsh-autosuggestions ;;
        */zsh-syntax-highlighting.zsh|*/zsh-syntax-highlighting.plugin.zsh|*/fast-syntax-highlighting.plugin.zsh|*/F-Sy-H.plugin.zsh)
          [[ " $off " == *" syntax-highlighting "* ]] && return 1; REPLY=${${1:t}%%.*} ;;
        */fzf-tab.plugin.zsh|*/fzf-tab.zsh) [[ " $off " == *" fzf-tab "* ]] && return 1; REPLY=fzf-tab ;;
        */fzf/shell/key-bindings.zsh|*/fzf/key-bindings.zsh|*/fzf/shell/completion.zsh|*/fzf/completion.zsh)
          [[ " $off " == *" fzf "* ]] && return 1; REPLY=fzf ;;
        *) return 1 ;;
      esac
    }
    # A skipped framework's commands do nothing for the rest of the file
    # (`zinit light …`, `antigen bundle …`, `p10k finalize`), instead of a
    # "command not found" in every new tab. $1: the label.
    _goatty_rc_quiet() {
      local cmd
      local -a cmds
      case $1 in
        oh-my-zsh) cmds=(omz) ;;
        powerlevel10k) cmds=(p10k) ;;
        prezto) cmds=(pmodload zprezto-update) ;;
        zim) cmds=(zimfw) ;;
        antigen) cmds=(antigen) ;;
        antidote) cmds=(antidote) ;;
        zinit) cmds=(zinit zi zini zicompinit zicdreplay) ;;
        zplug) cmds=(zplug) ;;
      esac
      for cmd in $cmds; do
        (( ${+functions[$cmd]} || ${+commands[$cmd]} )) && continue
        functions[$cmd]=':'
        _goatty_rc_stubs+=($cmd)
      done
    }
    # Tools whose init goatty's plugins do (unless that plugin is off). The
    # init runs in a command substitution (`eval "$(starship init zsh)"`,
    # `source <(fzf --zsh)`), so the stub prints the line that records it.
    _goatty_rc_stub() {
      local cmd=$1 arg=$2 plugin=$3
      [[ ${_goatty_state[$plugin]} == off ]] && return
      (( ${+functions[$cmd]} )) && return
      functions[$cmd]="if [[ \$1 == ${(q)arg} ]]; then builtin print -r -- '_goatty_rc_skipped+=(${(q)cmd})'; return 0; fi; command ${(q)cmd} \"\$@\""
      _goatty_rc_stubs+=($cmd)
    }
    typeset -ga _goatty_rc_stubs=()
    _goatty_rc_stub starship init starship
    _goatty_rc_stub oh-my-posh init starship
    _goatty_rc_stub fzf --zsh fzf
    # goatty ran compinit; a second run is slow and resets completion. Its
    # definition (if zsh kept one) comes back afterwards.
    if (( ${+functions[compinit]} )); then
      typeset -g _goatty_rc_compinit=$functions[compinit]
    fi
    compinit() { : }
    # The caller's argument count and arguments go along (see rc-guard.zsh).
    builtin alias source="builtin source ${(q)_goatty_dir}/rc-guard.zsh \$# \"\$@\""
    builtin alias .="builtin source ${(q)_goatty_dir}/rc-guard.zsh \$# \"\$@\""
    builtin source -- "$REPLY"
    builtin unalias source . 2>/dev/null
    (( $#_goatty_rc_stubs )) && builtin unfunction $_goatty_rc_stubs 2>/dev/null
    if (( ${+_goatty_rc_compinit} )); then
      functions[compinit]=$_goatty_rc_compinit
      builtin unset _goatty_rc_compinit
    else
      builtin unfunction compinit 2>/dev/null
    fi
    builtin unfunction _goatty_rc_blocked _goatty_rc_stub _goatty_rc_quiet
    for REPLY in ${(u)_goatty_rc_skipped}; do
      _goatty_state[rc:$REPLY]=off
    done
    builtin unset _goatty_rc_skipped _goatty_rc_stubs _goatty_rc_caller
  fi
  _goatty_zdotdir_capture
  builtin export ZDOTDIR=$_goatty_dir
  _goatty_path_marks+=("zshrc"$'\t'"$PATH")
fi

# --- Plugins: line editor tools --------------------------------------------
# fzf (Ctrl+R, Ctrl+T, Alt+C), then fzf-tab (Tab), then autosuggestions,
# which wraps the widgets defined before it.
builtin source -- "$_goatty_dir/plugins-line-editor.zsh"

# --- Prompt -----------------------------------------------------------------
# The Starship plugin (or another prompt plugin); goatty's config for it is
# generated from the prompt settings.
builtin source -- "$_goatty_dir/plugins-prompt.zsh"
# Kept when your .zshrc set a prompt of its own.
if (( ! ${+_goatty_prompt} )) && [[ $PS1 == "$_goatty_ps1_before" ]]; then
  # Small built-in prompt: directory, then a marker that turns red when
  # the last command failed.
  if (( _goatty_prompt_two_line )); then
    PROMPT='%F{blue}%~%f'$'\n''%(?.%F{green}.%F{red})%(!.#.❯)%f '
  else
    PROMPT='%F{blue}%~%f %(?.%F{green}.%F{red})%(!.#.❯)%f '
  fi
  RPROMPT=
fi

# --- Plugins: aliases and the plugins' own shell code ------------------------
# After the prompt; before your additions (so you can override a plugin's
# alias) and syntax highlighting.
builtin source -- "$_goatty_dir/plugins.zsh"

# --- Your aliases from goatty's settings (Aliases page, `goattyd alias`) ----
# After the plugins' aliases, so one of yours with the same name wins.
builtin source -- "$_goatty_dir/aliases.zsh"
_goatty_path_marks+=("plugins"$'\t'"$PATH")

# --- Shell integration: OSC 133 prompt marks, OSC 7 working directory -------
if _goatty_on integration && builtin source -- "$_goatty_dir/integration.zsh"; then
  _goatty_ok integration "$_goatty_dir/integration.zsh"
else
  _goatty_state[integration]=off
fi

# --- Transient prompt (prompt.transient) ------------------------------------
# When a command is accepted, its prompt is redrawn as just the prompt
# character (colored by the status that prompt showed), so scrollback keeps
# the commands, not every full prompt. zle draws after the widget returns,
# so the full prompt comes back in precmd (first, before anything that
# looks at PS1). After integration, so the short prompt keeps the OSC 133
# marks when the full one has them.
if (( _goatty_prompt_transient && $+builtins[zle] )); then
  builtin setopt transient_rprompt
  typeset -gi _goatty_last_status=0
  _goatty_transient_precmd() {
    _goatty_last_status=$?
    if (( ${+_goatty_full_ps1} )); then
      PS1=$_goatty_full_ps1
      builtin unset _goatty_full_ps1
    fi
  }
  _goatty_transient() {
    [[ $CONTEXT == start ]] || return 0
    typeset -g _goatty_full_ps1=$PS1
    if (( _goatty_last_status )); then PS1=$_goatty_transient_err; else PS1=$_goatty_transient_ok; fi
    [[ $_goatty_full_ps1 == *$'\e]133;A'* ]] && PS1=$'%{\e]133;A\a%}'$PS1$'%{\e]133;B\a%}'
    zle .reset-prompt
  }
  precmd_functions=(_goatty_transient_precmd $precmd_functions)
  builtin autoload -Uz add-zle-hook-widget
  add-zle-hook-widget line-finish _goatty_transient
fi

# Nothing below needs goatty's ZDOTDIR: hand it back to the user now, so
# their additions (and everything started later) see their own.
_goatty_zdotdir_user

# --- The user's additions ---------------------------------------------------
if [[ -r $_goatty_user_zshrc ]]; then
  builtin source -- "$_goatty_user_zshrc"
fi
_goatty_path_marks+=("additions"$'\t'"$PATH")

# --- Plugins that load last: syntax highlighting ---------------------------
# It wraps every line editor widget defined before it, yours included.
builtin source -- "$_goatty_dir/plugins-last.zsh"

# --- Commands ---------------------------------------------------------------

# What this shell loaded: feature<TAB>state[<TAB>detail].
goatty-status() {
  local k
  for k in ${(ko)_goatty_state}; do
    builtin print -r -- "$k"$'\t'"${_goatty_state[$k]}"
  done
}

# Outdated managed tools: built-in plugins whose loaded copy lives under
# $_goatty_tools at a version other than $_goatty_pins[$k]. Sets $reply
# (pure zsh, no subprocesses).
_goatty_outdated_tools() {
  reply=()
  local tools_real=${_goatty_tools:A} k v detail rel rest ver
  for k in ${(ko)_goatty_pins}; do
    v=${_goatty_state[$k]-}
    [[ $v == ok$'\t'* ]] || continue
    detail=${${v#ok$'\t'}:A}
    [[ $detail == "$tools_real"/* ]] || continue
    rel=${detail#"$tools_real"/}
    rest=${rel#*/}
    [[ $rest == */* ]] || continue
    ver=${rest%%/*}
    [[ -n $ver && $ver != $_goatty_pins[$k] ]] && reply+=($k)
  done
}

# Install the missing tools (and update outdated managed copies) of goatty's
# built-in plugins into goatty's data directory (no sudo), then reload.
# Named ones (`goatty-setup fzf`) too.
goatty-setup() {
  local daemon=${_goatty_daemon:-goattyd}
  if [[ $1 == --dismiss ]]; then
    "$daemon" shell dismiss
    return
  fi
  if (( $# == 0 )); then
    local -a reply missing=(${(ko)_goatty_state[(R)missing]})
    missing=(${missing:*_goatty_setup_defaults})
    _goatty_outdated_tools
    local -aU todo=($missing $reply)
    todo=(${(o)todo})
    if (( ${#todo} == 0 )); then
      "$daemon" shell install && goatty-reload
      return
    fi
    set -- $todo
  fi
  "$daemon" shell install -- "$@" && goatty-reload
}

# Restart this shell with goatty's configuration.
goatty-reload() {
  if (( ${+ZDOTDIR} )); then
    builtin export GOATTY_ORIG_ZDOTDIR=$ZDOTDIR
  fi
  ZDOTDIR=$_goatty_dir builtin exec "${commands[zsh]:-zsh}" -l
}

# --- Reload on request -------------------------------------------------------
# After host settings change, goatty can ask running shells to pick up the
# new configuration: it sends SIGURG (ignored by default, so other programs
# don't care). An idle, empty prompt reloads right away; otherwise the shell
# reloads at its next prompt. A shell with jobs only says so: exec would
# lose them.
builtin zmodload -F zsh/parameter p:jobstates 2>/dev/null
typeset -gi _goatty_reload_pending=0

_goatty_reload_requested() {
  (( _goatty_reload_pending )) || return 0
  _goatty_reload_pending=0
  if (( ${#jobstates} )); then
    builtin print -r -- $'\e[33mgoatty:\e[0m shell settings changed; run \e[1mgoatty-reload\e[0m once your jobs are done.'
    return 0
  fi
  goatty-reload
}

# Abandon the empty line, so the precmd hook runs and reloads. (From a trap,
# accept-line would only take effect on the next keypress; send-break
# returns to the top level at once.)
# Only touch zle from inside the trap when the builtin is really there. The
# signal can arrive before zle is loaded (non-interactive, or a build where
# the zle module isn't available); then the flag stays set and the reload
# happens at the next prompt instead.
# Inspect CONTEXT/BUFFER directly and invoke only the built-in `.send-break`
# rather than calling a user widget (`zle _...`), because invoking a user
# widget from a signal trap while zle-line-pre-redraw hooks (such as
# zsh-syntax-highlighting) are running calls execzlefunc/doshfunc re-entrantly
# and corrupts zsh's heap.
TRAPURG() {
  _goatty_reload_pending=1
  if (( $+builtins[zle] )) && zle && [[ $CONTEXT == start && -z $BUFFER ]]; then
    zle .send-break
  fi
  return 0
}

# The signal can also land after precmd but before zle reads the new line
# (while the prompt is drawn): `zle` isn't active yet, so the trap only sets
# the flag. Catch that when the line editor starts, or an idle shell would
# wait for the next command to reload.
if (( $+builtins[zle] )); then
  _goatty_reload_line_init() {
    (( _goatty_reload_pending )) && [[ -z $BUFFER ]] && zle .send-break
    return 0
  }
  builtin autoload -Uz add-zle-hook-widget
  add-zle-hook-widget line-init _goatty_reload_line_init
fi

builtin autoload -Uz add-zsh-hook
add-zsh-hook precmd _goatty_reload_requested

# --- Missing/outdated-tools hint --------------------------------------------
# Missing tools stay quiet once dismissed, once goatty's window offered the
# install, and in sessions of a goatty window that offers it itself
# (GOATTY_GUI_SETUP). Outdated managed tools still notify unless dismissed or
# inside a GUI window that offers the setup itself.
() {
  local -a reply missing outdated
  if [[ ! -e $_goatty_offer_marker ]]; then
    missing=(${(ko)_goatty_state[(R)missing]})
    missing=(${missing:*_goatty_setup_defaults})
  fi
  _goatty_outdated_tools
  outdated=($reply)
  (( $#missing || $#outdated )) && [[ -t 1 && -z $GOATTY_GUI_SETUP && ! -e $_goatty_hint_marker ]] || return 0
  local -a parts
  (( $#missing )) && parts+=("not installed: ${(j:, :)missing}")
  (( $#outdated )) && parts+=("outdated: ${(j:, :)outdated}")
  local action=install
  if (( $#missing && $#outdated )); then
    action='install/update'
  elif (( $#outdated )); then
    action=update
  fi
  builtin print -r -- $'\e[33mgoatty:\e[0m '"${(j:; :)parts}"$'. Run \e[1mgoatty-setup\e[0m to '"$action"$' (user space, no sudo), \e[1mgoatty-setup --dismiss\e[0m to hide this.'
}

# --- Done --------------------------------------------------------------------
builtin unfunction _goatty_zdotdir_user _goatty_zdotdir_capture _goatty_user_file _goatty_on _goatty_find _goatty_ok
builtin unset _goatty_user_zdotdir _goatty_src _goatty_prompt GOATTY_GUI_SETUP _goatty_ps1_before
builtin unset _goatty_imported_vars _goatty_imported_path _goatty_imported_from
